# Environment Variables for NeoBite Restaurant

# =============================================
# Gmail SMTP Configuration (Backend)
# =============================================
# Your Gmail address (e.g., yourname@gmail.com)
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Get this from: https://myaccount.google.com/apppasswords
# Note: You need to enable 2-Factor Authentication first
GMAIL_APP_PASSWORD=your-16-character-app-password

# Backend Server Port
PORT=3001

# =============================================
# Frontend Configuration
# =============================================
# Backend API URL (for frontend to call)
VITE_API_URL=http://localhost:3001

# =============================================
# Payment Gateway Configuration
# =============================================
# Stripe Publishable Key (for Credit/Debit Card payments)
# Get from: https://dashboard.stripe.com/test/apikeys
# Use pk_test_... for testing, pk_live_... for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# PayPal Client ID (for PayPal payments)
# Get from: https://developer.paypal.com/dashboard/applications
# Use sandbox client ID for testing
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# =============================================
# Instructions:
# =============================================
# 1. Copy this file to .env (without .example)
# 2. Replace placeholders with your actual credentials:
#    - Gmail: your-email@gmail.com + app password (16 chars, no spaces)
#    - Stripe: Get from https://dashboard.stripe.com/test/apikeys
#    - PayPal: Get from https://developer.paypal.com/dashboard
# 3. Never commit the .env file to version control!
# 4. Run 'npm install' to install dependencies
# 5. Run 'npm run server' to start backend (Terminal 1)
# 6. Run 'npm run dev' to start frontend (Terminal 2)
# 7. See PAYMENT_SETUP_GUIDE.md for detailed payment setup instructions

